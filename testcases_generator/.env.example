# ---- GitHub ----
GITHUB_TOKEN=ghp_xxx                 # PAT with repo:read (contents + issues)
GITHUB_OWNER=your-org                # org or user that owns the repo
GITHUB_REPO=your-repo
GITHUB_REF=main
GITHUB_REQ_PATHS=README.md,docs/     # files/dirs scanned for requirement text
GITHUB_ISSUE_LABEL=requirement       # optional: also pull open issues with this label

# ---- Model (test case generation) ----
# Only the selected provider's key is required.
MODEL_PROVIDER=anthropic             # anthropic | openai | ollama

# if MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5

# if MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-xxx
# OPENAI_MODEL=gpt-4o               # set to a model your account can access

# if MODEL_PROVIDER=ollama  (no API key needed — Ollama runs locally)
# OLLAMA_MODEL=qwen2.5              # or llama3.1, mistral-nemo, etc.
# OLLAMA_BASE_URL=http://localhost:11434/v1   # default if not set

MODEL_MAX_TOKENS=16000
NUM_TEST_CASES=5

# ---- TestRail ----
TESTRAIL_URL=https://yourorg.testrail.io
TESTRAIL_USER=you@yourorg.com
TESTRAIL_API_KEY=xxxx                # TestRail > My Settings > API Keys
TESTRAIL_PROJECT_ID=1
TESTRAIL_SUITE_ID=                   # leave blank for single-suite projects
TESTRAIL_SECTION_ID=10
TESTRAIL_TEMPLATE_ID=                # optional
TESTRAIL_TYPE_ID=                    # optional
TESTRAIL_PRIORITY_ID=                # optional

# ---- Slack (pick one) ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# SLACK_BOT_TOKEN=xoxb-xxx
# SLACK_CHANNEL=#qa-automation

# ---- Jira (optional — leave blank if not using Jira) ----
# JIRA_BASE_URL=https://yourorg.atlassian.net
# JIRA_USER=you@yourorg.com
# JIRA_API_TOKEN=xxxx     # Atlassian account → Security → API tokens
# JIRA_API_VERSION=3      # 3 = Cloud (default), 2 = Server / Data Center

# ---- Misc ----
AGENT_WORKDIR=./qa_run
